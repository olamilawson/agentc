# Personal Agent — Foundation phase
# Copy to .env and fill in. Secrets live outside the repository and never in prompts.

# Local development (default): SQLite for app tables + LangGraph checkpoints.
# On the VPS: postgresql+psycopg://personal_agent:PASSWORD@postgres:5432/personal_agent
PERSONAL_AGENT_DATABASE_URL=

# LangGraph checkpoint file, used when the database URL above is SQLite. When it
# is Postgres, checkpoints go to that Postgres database and this is ignored.
PERSONAL_AGENT_CHECKPOINT_DB=

# One key per provider, from the VPS environment or a secrets file outside the repo.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Route table and budgets live in config/ and are version-controlled (no secrets there).
PERSONAL_AGENT_ROUTE_TABLE=config/route_table.yaml
PERSONAL_AGENT_BUDGETS=config/budgets.yaml

# Optional overrides; each defaults to a path under the repository root.
# PERSONAL_AGENT_SPONSORSHIP=config/sponsorship.yaml
# PERSONAL_AGENT_SKILLS_DIR=skills
# PERSONAL_AGENT_CLIENTS_DIR=data/clients

# --- Server only (docker-compose.yml reads these) ---------------------------------
# The local port the app listens on; the server's nginx passes ijeoma.pro to it.
# API_PORT=8100
# For the Caddy profile only (a server with nothing else on ports 80 and 443).
# AGENT_DOMAIN=ijeoma.pro
# AGENT_ADMIN_EMAIL=
# A long random value. Postgres takes it on first start.
POSTGRES_PASSWORD=
# The name in the rail and the page titles.
PERSONAL_AGENT_NAME=Chidimma OS

# Owner sign-in. Create these three on the server with:
#   docker compose run --rm api python -m personal_agent.auth
# and paste the lines it prints. The server refuses every request until all three are set.
PERSONAL_AGENT_OWNER_PASSWORD_HASH=
PERSONAL_AGENT_TOTP_SECRET=
PERSONAL_AGENT_SESSION_SECRET=
# Hours before a session asks you to sign in again.
# PERSONAL_AGENT_SESSION_HOURS=12

# Microsoft Graph mail (deploy/microsoft-graph.md). Leave all four empty and the
# agent holds approved replies in its local outbox and sends none.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# The address of the one mailbox the agent reads and sends from.
MS_GRAPH_MAILBOX=
# The address whose calendar the agent reads for free time when it proposes a
# call. Empty: the mailbox above.
MS_GRAPH_CALENDAR=

# Shared secret n8n sends in the x-agent-secret header when it posts new
# sponsorship mail. Leave empty and the webhook stays off.
PERSONAL_AGENT_N8N_SECRET=
